# ===== 数据库 =====
POSTGRES_USER=hra
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=hra
DATABASE_URL=postgresql+asyncpg://hra:change-me-strong-password@localhost:5432/hra

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ===== JWT =====
JWT_SECRET=change-me-64-char-random-secret-please-generate-securely
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ===== PII Fernet 加密 =====
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_FERNET_KEY=change-me-generate-fernet-key
PII_KEY_ROTATION_DAYS=90

# ===== PII 检索哈希 pepper（HMAC-SHA256） =====
# 独立随机字符串（非 Fernet key）；缺失时回退从 PII_FERNET_KEY 派生并告警。
# 注意：更换 pepper 会使存量 *_hash 检索索引失效，需离线重算迁移。
PII_HASH_PEPPER=change-me-random-pepper-for-pii-hash

# ===== 登录防爆破 =====
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ===== 反向代理可信层数（XFF 从右往左取第 N 段为真实客户端 IP） =====
TRUSTED_PROXY_COUNT=1

# ===== LLM（主：通义千问 Max，规避跨境传输 ADR-003） =====
DASHSCOPE_API_KEY=sk-change-me
LLM_PRIMARY=qwen-max
LLM_FALLBACK=deepseek-v3
LLM_OPTIONAL=gpt-4-turbo
OPENAI_API_KEY=
OPENAI_ENABLED=false
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_RATE_LIMIT=10

# ===== 邮件 =====
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ===== 短信 =====
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=
SMS_SECRET_KEY=

# ===== OSS =====
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=hra-backup
OSS_REGION=oss-cn-hangzhou

# ===== 监控 =====
METRICS_ACCESS_TOKEN=
SENTRY_DSN=

# ===== 业务 =====
PASSWORD_RESET_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=100/minute

# ===== RAG 知识库问答（feat/rag-kb：需 PostgreSQL + .[rag] 依赖组） =====
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_DIM=1024
# dashscope（生产）| hash（仅离线开发/测试的确定性嵌入）
RAG_EMBEDDING_PROVIDER=dashscope
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=gte-rerank
RAG_RERANK_TIMEOUT_MS=800
RAG_MIN_SCORE=0.012
RAG_MIN_COSINE=0.62
RAG_MIN_COVERAGE=0.26
RAG_CHUNK_TOKENS=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# ===== 应用 =====
APP_ENV=development          # development | production（生产禁用 create_all 兜底）
LOG_LEVEL=INFO
LOG_FORMAT=text              # text | json（生产建议 json，含 request_id 便于采集）
