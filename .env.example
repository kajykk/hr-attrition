# HRA 项目根 .env.example（参考 D10 2.2）
# 复制为 .env 后填入真实值

# ===== 数据库（生产用阿里云 RDS PostgreSQL 15，本地用镜像） =====
POSTGRES_USER=hra
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=hra
DATABASE_URL=postgresql+asyncpg://hra:change-me-strong-password@postgres:5432/hra

# ===== Redis（生产用阿里云 Redis 7 托管，本地用镜像） =====
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ===== JWT =====
JWT_SECRET=change-me-64-char-random-secret-please-generate-securely
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ===== PII Fernet 加密（季度轮换） =====
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_FERNET_KEY=change-me-generate-fernet-key
PII_KEY_ROTATION_DAYS=90

# ===== LLM（主：通义千问 Max，规避跨境传输 ADR-003） =====
DASHSCOPE_API_KEY=sk-change-me
LLM_PRIMARY=qwen-max
LLM_FALLBACK=deepseek-v3
LLM_OPTIONAL=gpt-4-turbo
OPENAI_API_KEY=
OPENAI_ENABLED=false
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_RATE_LIMIT=10

# ===== 邮件 =====
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ===== 短信 =====
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=
SMS_SECRET_KEY=

# ===== OSS =====
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=hra-backup
OSS_REGION=oss-cn-hangzhou

# ===== 监控 =====
METRICS_ACCESS_TOKEN=
SENTRY_DSN=

# ===== 业务 =====
PASSWORD_RESET_BASE_URL=https://hra.example.com
CORS_ORIGINS=https://hra.example.com
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=100/minute

# ===== 应用 =====
APP_ENV=production
LOG_LEVEL=INFO
